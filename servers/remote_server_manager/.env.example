PG_USER=[DATABASE USER]
PG_PASSWORD=[DATABASE PASSWORD]
PG_DIALECT=[DIALECT]
PG_DRIVER=[DRIVER]
PG_PORT=[PORT]
PG_HOSTNAME=[HOSTNAME]
PG_DATABASE=[DATABASE]

MCP_NAME="Remote Server Manager MCP"
MCP_PORT=8000
PROMETHEUS_PORT=9090

APP_VERSION="DEV"

# Command restrictions (comma-separated group names, see SECURITY.md)
# Opt in to groups that are off by default, e.g. privilege_escalation
ENABLED_RESTRICTIONS=""
# Opt out of groups that are on by default, e.g. power,remote_access (destructive and user_management are always on)
DISABLED_RESTRICTIONS=""
# Additional regex patterns to block, one per line
EXTRA_FORBIDDEN_PATTERNS=""

# Comma-separated IP addresses and/or CIDR ranges SSH sessions may be created with (empty allows all hosts)
ALLOWED_HOSTS=""
